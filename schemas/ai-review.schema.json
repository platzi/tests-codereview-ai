{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payments-svc AI review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_mode",
    "model",
    "diff_summary",
    "action",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "review_mode": {
      "type": "string",
      "enum": [
        "pull_request"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "diff_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "action": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "block"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "category",
          "file",
          "line",
          "evidence",
          "recommendation",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "correctness",
              "tests",
              "maintainability",
              "unknown"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "action": {
            "type": "string",
            "enum": [
              "report",
              "warn",
              "block"
            ]
          }
        }
      }
    }
  }
}